# ───────── Core ─────────
DJANGO_SECRET_KEY=django-super-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Tashkent

# ───────── PostgreSQL ─────────
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ───────── Email / SendGrid ─────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.xxxxxxx
DEFAULT_FROM_EMAIL=noreply@guidematcher.com

# ───────── CORS ─────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://guidematcher.com

# ───────── Celery / Redis ─────────
CELERY_BROKER_URL=redis://localhost:6379/0

# ───────── Sentry (prod) ─────────
# SENTRY_DSN=https://xxxxxxx@o000.ingest.sentry.io/000




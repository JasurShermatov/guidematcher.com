# ───────── Django ─────────
DJANGO_SECRET_KEY=super-uzun-tasodifiy-maxfiy-kalit
DEBUG=False
ALLOWED_HOSTS=uzguide.com,www.uzguide.com,127.0.0.1,localhost,backend
TIME_ZONE=Asia/Tashkent

# Reverse-proxy (Caddy) ortida HTTPS ni tanitish
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# CSRF ishonchli domenlar (prod)
CSRF_TRUSTED_ORIGINS=https://uzguide.com,https://www.uzguide.com

# Cookie’lar faqat HTTPS’da (prod)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ───────── Database (PostgreSQL) ─────────
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ───────── Redis / Celery / Channels ─────────
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/2

# Celery natija backend (settings’da REDIS_URL ishlatiladi)
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True

# ───────── CORS ─────────
CORS_ALLOWED_ORIGINS=https://uzguide.com,https://www.uzguide.com
CORS_ALLOW_CREDENTIALS=True

# ───────── Frontend → backend API URL (agar frontend buildga kerak bo‘lsa) ─────────
REACT_APP_API_URL=https://uzguide.com/api/v1/

# --- Email via Brevo API (NO SMTP) ---
EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
ANYMAIL_BREVO_API_KEY=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
DEFAULT_FROM_EMAIL=info@uzguide.com
EMAIL_TIMEOUT=15

# (ixtiyoriy) Brevo ishlatsangiz:

# ───────── Logging ─────────
DJANGO_LOG_LEVEL=INFO


# --- Django ---
DJANGO_SECRET_KEY=super-uzun-tasodifiy-maxfiy-kalit
DEBUG=False
ALLOWED_HOSTS=uzguide.com,www.uzguide.com,127.0.0.1,localhost,backend
TIME_ZONE=Asia/Tashkent


# Caddy reverse-proxy ortida HTTPS’ni to‘g‘ri tanitish
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# CSRF uchun ishonchli domenlar
CSRF_TRUSTED_ORIGINS=https://uzguide.com,https://www.uzguide.com

# Cookie’lar faqat HTTPS’da yuborilsin (prod tavsiya)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# (ixtiyoriy, lekin yaxshi) XSS va iFrame himoya
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# --- Database ---
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432


# --- Redis / Celery / Channels ---
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/2

# --- CORS (frontend HTTPS domenlari) ---
CORS_ALLOWED_ORIGINS=https://uzguide.com,https://www.uzguide.com
CORS_ALLOW_CREDENTIALS=True

# --- API URL frontend build uchun ---
REACT_APP_API_URL=https://uzguide.com/api/v1/


# --- Celery ---
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True

# --- Logging ---
DJANGO_LOG_LEVEL=INFO







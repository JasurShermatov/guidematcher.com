EMAIL_HOST=uz01.ahost.uz
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=info@uzguide.com
EMAIL_HOST_PASSWORD=&a(bq5vh^,!{b?l*

# Frontend Environment Variables

# API Base URL - Backend server address
REACT_APP_API_URL=http://localhost:8000/api/v1/

# App Configuration
REACT_APP_APP_NAME=Travel Guide App
REACT_APP_VERSION=1.0.0

# Development/Production Mode
NODE_ENV=development

# Enable/Disable source maps in production
GENERATE_SOURCEMAP=false

# Enable detailed error reporting
REACT_APP_DEBUG=true

# Google OAuth Configuration (if using)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here

# Facebook OAuth Configuration (if using)
REACT_APP_FACEBOOK_APP_ID=your_facebook_app_id_here

# Default Language
REACT_APP_DEFAULT_LANGUAGE=en

# Feature Flags
REACT_APP_ENABLE_PWA=false
REACT_APP_ENABLE_ANALYTICS=false

# Build Configuration
BUILD_PATH=build
PUBLIC_URL=/

# Webpack Bundle Analyzer (for development)
ANALYZE=false

REACT_APP_WS_HOST=localhost:8000